---
import type {CollectionEntry} from "astro:content";

interface Props {
    article: CollectionEntry<"articles">;
}

const {article} = Astro.props as Props;
---

<article>
    <h3>
        <a href={`/blog/${article.slug}/`}>{article.data.title}</a>
    </h3>
    <span> - </span>
    <time datetime={article.data.datePublished}>
        {
            new Date(article.data.datePublished).toLocaleDateString("en-US", {
                year: "numeric",
                month: "long",
                day: "numeric",
            })
        }
    </time>
    {article.data.excerpt && <p class="excerpt" set:html={article.data.excerpt} />}
</article>
