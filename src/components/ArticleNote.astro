---
interface Props {
    label?: string | undefined;
}

const {label} = Astro.props as Props;
---

<div class="note">
    {label && <p class="note-label">{label}</p>}
    <slot />
</div>

<style>
    .note {
        color: var(--color-lighter-gray);

        .note-label {
            font-weight: 600;
        }
    }
</style>
