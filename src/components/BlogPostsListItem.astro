---
import type {CollectionEntry} from "astro:content";

interface Props {
    blogPost: CollectionEntry<"blog-posts">;
}

const {blogPost} = Astro.props as Props;
---

<article>
    <h3>
        <a href={`/blog/${blogPost.slug}`}>{blogPost.data.title}</a>
    </h3>
    <span> - </span>
    <time datetime={blogPost.data.datePublished}>
        {new Date(blogPost.data.datePublished).toLocaleDateString("en-US", {
            year: "numeric",
            month: "long",
            day: "numeric",
        })}
    </time>
    {blogPost.data.excerpt && <p class="excerpt" set:html={blogPost.data.excerpt} />}
</article>
