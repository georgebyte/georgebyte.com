---
import DefaultLayout from "./DefaultLayout.astro";
import type {CollectionEntry} from "astro:content";

interface Props {
    title: string;
    description: string;
    blogPosts: CollectionEntry<"blog-posts">[];
}

const {title, description, blogPosts} = Astro.props as Props;

const sortedBlogPosts = [...blogPosts].sort((a, b) => {
    return new Date(b.data.datePublished).getTime() - new Date(a.data.datePublished).getTime();
});

const blogPostsGroupedByYear = new Map<string, CollectionEntry<"blog-posts">[]>();
for (const blogPost of sortedBlogPosts) {
    const year = new Date(blogPost.data.datePublished).getFullYear().toString();
    if (!blogPostsGroupedByYear.has(year)) {
        blogPostsGroupedByYear.set(year, []);
    }
    blogPostsGroupedByYear.get(year)!.push(blogPost);
}
---

<DefaultLayout title={title} description={description}>
    <h1>{title}</h1>
    {description && <p>{description}</p>}
    {
        Array.from(blogPostsGroupedByYear.entries()).map(([year, blogPosts]) => (
            <section>
                <h2>{year}</h2>
                {blogPosts.map(blogPost => (
                    <article>
                        <h3>
                            <a href={`/blog/${blogPost.slug}`}>{blogPost.data.title}</a>
                        </h3>
                        <span> - </span>
                        <time datetime={blogPost.data.datePublished}>
                            {new Date(blogPost.data.datePublished).toLocaleDateString("en-US", {
                                year: "numeric",
                                month: "long",
                                day: "numeric",
                            })}
                        </time>
                        {blogPost.data.excerpt && (
                            <p class="excerpt" set:html={blogPost.data.excerpt} />
                        )}
                    </article>
                ))}
            </section>
        ))
    }
</DefaultLayout>
