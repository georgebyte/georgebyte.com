---
import "../styles/global.css";
import {siteConfig} from "../config/site";

interface Props {
    title?: string;
    htmlTitle?: string;
    description?: string;
    excerpt?: string;
    featuredImage?: string;
}

const {title, htmlTitle, description, excerpt, featuredImage} = Astro.props as Props;
const computedTitle = htmlTitle ?? (title ? `${title} • ${siteConfig.name}` : siteConfig.name);
const metaDescription = description ?? excerpt ?? siteConfig.description;
const canonicalUrl = new URL(Astro.url.pathname, siteConfig.url).toString();
const openGraphTitle = title ?? siteConfig.name;
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta content="text/html; charset=utf-8" http-equiv="Content-Type" />
        <meta http-equiv="X-UA-Compatible" content="IE=edge" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0" />
        <title>{computedTitle}</title>
        <meta name="description" content={metaDescription} />
        <meta property="og:description" content={metaDescription} />
        <!-- TODO (gb): Replace with X properties -->
        <meta property="twitter:description" content={metaDescription} />
        <meta property="og:title" content={openGraphTitle} />
        <!-- TODO (gb): Replace with X properties -->
        <meta property="twitter:title" content={openGraphTitle} />
        {
            featuredImage && (
                <>
                    <meta property="og:image" content={`${siteConfig.url}${featuredImage}`} />
                    <meta property="twitter:image" content={`${siteConfig.url}${featuredImage}`} />
                    <meta property="twitter:card" content="summary_large_image" />
                </>
            )
        }
        <meta name="author" content={siteConfig.name} />
        <link rel="canonical" href={canonicalUrl} />
        <link
            rel="alternate"
            type="application/rss+xml"
            title={`${siteConfig.name} - ${siteConfig.description}`}
            href={siteConfig.rssFeedUrl}
        />
        <link rel="shortcut icon" href="/favicon.ico" type="image/x-icon" />
        <link rel="icon" href="/favicon.ico" type="image/x-icon" />
        <!-- TODO (gb): Do I need external fonts here? Try to eliminate google fonts -->
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css?family=Merriweather:300,400,400i,700"
            rel="stylesheet"
        />
        <link
            href="https://fonts.googleapis.com/css?family=Open+Sans+Condensed:300,700"
            rel="stylesheet"
        />
        {Astro.slots.has("head") && <slot name="head" />}
    </head>
    <body>
        <slot />
        {Astro.slots.has("body-end") && <slot name="body-end" />}
    </body>
</html>
