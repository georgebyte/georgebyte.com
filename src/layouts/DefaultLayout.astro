---
import {siteConfig} from "../config/site";
import BlankLayout from "./BlankLayout.astro";
import NavigationLinks from "@components/NavigationLinks.astro";
import IconLinks from "@components/IconLinks.astro";
---

<BlankLayout {...Astro.props}>
    <div class="wrapper">
        <div class="wrapper-masthead">
            <div class="container">
                <header class="masthead clearfix">
                    <a href="/" class="site-avatar">
                        <img
                            src={siteConfig.avatar.primary}
                            srcset={`${siteConfig.avatar.primary} 1x, ${siteConfig.avatar.retina} 2x`}
                            alt="George Byte's profile photo"
                        />
                    </a>

                    <div class="site-info">
                        <h2 class="site-name">
                            <a href="/">{siteConfig.name}</a>
                        </h2>
                        <p class="site-description">{siteConfig.description}</p>
                    </div>

                    <nav>
                        <NavigationLinks />
                    </nav>
                </header>
            </div>
        </div>

        <div id="main" role="main" class="container">
            <slot />
        </div>
    </div>

    <div class="wrapper-footer">
        <div class="container">
            <footer class="footer">
                <IconLinks />
            </footer>
        </div>
    </div>
</BlankLayout>

<style>
    .wrapper {
        flex: 1 0 auto;
    }

    .container {
        margin: 0 auto;
        max-width: 820px;
        padding: 0 10px;
        width: 100%;
    }

    .wrapper-masthead {
        margin-bottom: 40px;
    }

    .masthead {
        padding: 20px 0;
        border-bottom: 1px solid var(--color-light-gray);

        @media (max-width: 740px) {
            text-align: center;
        }
    }

    .site-avatar {
        float: left;
        width: 75px;
        height: 75px;
        margin-right: 15px;

        @media (max-width: 740px) {
            float: none;
            display: block;
            margin: 0 auto;
        }

        img {
            border-radius: 5px;
        }
    }

    .site-info {
        float: left;

        @media (max-width: 740px) {
            float: none;
            display: block;
            margin: 0 auto;
        }
    }

    .site-name {
        margin: 0;
        cursor: pointer;
        font-family: var(--font-titles);
        font-size: 35px;
        line-height: 35px;

        a {
            color: var(--color-dark-gray);

            &:hover,
            &:active {
                color: var(--color-primary);
            }
        }
    }

    .site-description {
        width: 300px;
        margin: 8px 0 0;
        color: var(--color-gray);
        font-family: var(--font-sans);
        font-size: 15px;
        line-height: 16px;

        @media (max-width: 740px) {
            width: auto;
        }
    }

    .masthead nav {
        float: right;
        font-family: var(--font-sans);
        font-size: 18px;

        @media (max-width: 740px) {
            float: none;
            margin-top: 9px;
            display: block;
            font-size: 16px;
        }

        :global(a) {
            margin-left: 20px;
            color: var(--color-dark-gray);
            text-align: right;
            font-weight: 300;
            letter-spacing: 1px;

            @media (max-width: 740px) {
                margin: 0 10px;
            }
        }

        :global(a:hover),
        :global(a:active) {
            color: var(--color-primary);
        }
    }

    .wrapper-footer {
        margin-top: 50px;
        border-top: 1px solid #ddd;
        border-bottom: 1px solid #ddd;
        background-color: var(--color-very-light-gray);
    }

    .footer {
        padding: 20px 0;
        text-align: center;
    }
</style>
