---
import DefaultLayout from "../../../layouts/DefaultLayout.astro";
import ArticlesList from "../../../components/ArticlesList.astro";
import type {CollectionEntry} from "astro:content";
import {getBlogTags} from "../../../utils/tags";

interface Props {
    tagLabel: string;
    articles: CollectionEntry<"articles">[];
}

export async function getStaticPaths() {
    const tags = await getBlogTags();
    return tags.map(tag => ({
        params: {tag: tag.slug},
        props: {tagLabel: tag.label, articles: tag.posts},
    }));
}

const {tagLabel, articles} = Astro.props as Props;

const title = `Tag: ${tagLabel}`;
const metaDescription = `George Byte's blog articles tagged with #${tagLabel}`;
const articlesCount = articles.length;
const description = `${articlesCount} ${articlesCount === 1 ? "article" : "articles"} tagged with #${tagLabel}`;
---

<DefaultLayout title={title} description={metaDescription}>
    <h1>#{tagLabel}</h1>
    <p>{description}</p>
    <ArticlesList articles={articles} />
</DefaultLayout>
