---
import DefaultLayout from "../../../layouts/DefaultLayout.astro";
import BlogPostsList from "../../../components/BlogPostsList.astro";
import type {CollectionEntry} from "astro:content";
import {getBlogTags} from "../../../utils/blogTags";

interface Props {
    tagLabel: string;
    blogPosts: CollectionEntry<"blog-posts">[];
}

export async function getStaticPaths() {
    const tags = await getBlogTags();
    return tags.map(tag => ({
        params: {tag: tag.slug},
        props: {tagLabel: tag.label, blogPosts: tag.posts},
    }));
}

const {tagLabel, blogPosts} = Astro.props as Props;

const title = `Tag: ${tagLabel}`;
const metaDescription = `George Byte's blog posts tagged with #${tagLabel}`;
const blogPostsCount = blogPosts.length;
const description = `${blogPostsCount} ${blogPostsCount === 1 ? "post" : "posts"} tagged with #${tagLabel}`;
---

<DefaultLayout title={title} description={metaDescription}>
    <h1>#{tagLabel}</h1>
    <p>{description}</p>
    <BlogPostsList blogPosts={blogPosts} />
</DefaultLayout>
