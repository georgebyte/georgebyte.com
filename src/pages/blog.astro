---
import {getCollection} from "astro:content";
import DefaultLayout from "../layouts/DefaultLayout.astro";
import ArticlesList from "../components/ArticlesList.astro";

const articles = await getCollection("articles");
const title = "Blog";
const metaDescription = "All George Byte's blog articles";
const description = "My writings about pretty much anything (mostly web development).";
---

<DefaultLayout title={title} description={metaDescription}>
    <h1>{title}</h1>
    <p>{description}</p>
    <ArticlesList articles={articles} />
</DefaultLayout>
