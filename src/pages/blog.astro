---
import {getCollection} from "astro:content";
import DefaultLayout from "../layouts/DefaultLayout.astro";
import BlogPostsList from "../components/BlogPostsList.astro";

const blogPosts = await getCollection("blog-posts");
const title = "Blog";
const metaDescription = "George Byte's blog posts";
const description = "My writings about pretty much anything (mostly web development).";
---

<DefaultLayout title={title} description={metaDescription}>
    <h1>{title}</h1>
    <p>{description}</p>
    <BlogPostsList blogPosts={blogPosts} />
</DefaultLayout>
